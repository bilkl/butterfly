# A loop feeds cells; an observer reacts when a threshold is crossed.
let sum = 0;
bind average = sum / 4;
bind big = sum > 5;

when big {
    print "seuil dépassé";
}

for i in 1..5 {
    let square = i * i;
    sum = sum + i;
    if i % 2 == 0 {
        print "pair", i, square, average;
    } else {
        print "impair", i, square, average;
    }
}

for j in 3..3 {
    print "jamais";
}

print sum, average, big;
