# Monthly budget: expenses that change and an alert on what is left.
soit salary = 2000;
soit rent = 800;
soit groceries = 300;
soit leisure = 150;

lie expenses = rent + groceries + leisure;
lie remaining = salary - expenses;
lie rate = expenses * 100 / salary;

quand remaining {
    si remaining < 0 {
        affiche "déficit de", abs(remaining);
    } sinon si remaining < 200 {
        affiche "juste, il reste", remaining;
    } sinon {
        affiche "confortable, il reste", remaining;
    }
}

affiche "départ :", expenses, remaining, rate;
groceries = groceries + 400;
leisure = 0;
leisure = 0;
rent = rent + 600;
salary = salary + 150;

pour month dans 1..4 {
    affiche "mois", month, ":", remaining * month;
}
affiche "taux final :", rate;
