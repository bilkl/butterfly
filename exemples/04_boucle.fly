# A loop feeds cells; an observer reacts when a threshold is crossed.
soit sum = 0;
lie average = sum / 4;
lie big = sum > 5;

quand big {
    affiche "seuil dépassé";
}

pour i dans 1..5 {
    soit square = i * i;
    sum = sum + i;
    si i % 2 == 0 {
        affiche "pair", i, square, average;
    } sinon {
        affiche "impair", i, square, average;
    }
}

pour j dans 3..3 {
    affiche "jamais";
}

affiche sum, average, big;
